server {
    listen 80;
    server_name _;

    # Augmenter la taille max pour l'upload d'images (5Mo-10Mo)
    client_max_body_size 10M;

    root  /usr/share/nginx/html;
    index index.html;

    # Compression Gzip
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied    any;
    gzip_vary       on;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json application/xml image/svg+xml;

    # ── Proxy API ────────────────────────────────────────────────────────────
    # Redirige toutes les requêtes /api vers le service API Render
    # API_URL est défini via variable d'environnement (ex: http://inventory-api:3000)
    location /api/ {
        proxy_pass         ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP          $remote_addr;
        proxy_set_header   X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        
        proxy_connect_timeout 60s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
        proxy_buffering off;
    }

    # ── Proxy images uploadées ───────────────────────────────────────────────
    location /uploads/ {
        proxy_pass         ${API_URL}/uploads/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        
        # Cache pour éviter de surcharger l'API à chaque vue d'image
        proxy_cache_valid  200 1d;
        add_header         Cache-Control "public, max-age=86400";
    }

    # ── Assets statiques (Vite / React) ──────────────────────────────────────
    location ~* \.(js|css|woff2?|ttf|eot|otf|ico|png|jpg|jpeg|gif|svg|webp)$ {
        expires    1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # ── SPA fallback (React Router / Wouter) ─────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Gestion des erreurs
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}