# =============================================================================
#  .env — Configuration de l'environnement Docker
#
#  Copiez ce fichier en ".env" et modifiez les valeurs.
#  Le fichier .env est lu automatiquement par docker compose.
# =============================================================================

# ── Base de données PostgreSQL ─────────────────────────────────────────────
POSTGRES_DB=inventory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_en_production

# ── Ports exposés sur l'hôte ───────────────────────────────────────────────
FRONTEND_PORT=80      # Application web
API_PORT=8080         # API REST (accès direct / Postman)

# ── Authentification JWT ───────────────────────────────────────────────────
# Générez un secret fort : openssl rand -base64 48
JWT_SECRET=changez_absolument_ce_secret_jwt_en_production

# ── Compte admin créé automatiquement au premier démarrage ─────────────────
ADMIN_EMAIL=admin@stockflow.com
ADMIN_PASSWORD=Admin1234!
ADMIN_NAME=Admin

# ── Stripe (paiement en ligne) ─────────────────────────────────────────────
# Récupérez vos clés sur https://dashboard.stripe.com/apikeys
# En mode test : préfixe pk_test_ / sk_test_
# En production : préfixe pk_live_ / sk_live_
VITE_STRIPE_PUBLIC_KEY=pk_test_REMPLACEZ_PAR_VOTRE_CLE_PUBLIQUE
STRIPE_SECRET_KEY=sk_test_REMPLACEZ_PAR_VOTRE_CLE_SECRETE

# Webhook Stripe (optionnel — pour confirmations asynchrones)
# stripe listen --forward-to localhost:8080/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_REMPLACEZ_PAR_VOTRE_SECRET_WEBHOOK
