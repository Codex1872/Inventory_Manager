# =============================================================================
#  Dockerfile.api
#  Deux stages :
#    builder  — installe toutes les dépendances et compile le bundle
#    runtime  — image minimale Node.js avec uniquement le bundle compilé
#
#  Le stage "builder" est aussi réutilisé par le service "migrate"
#  dans docker-compose.yml (target: builder).
# =============================================================================

# ─── Stage 1 : Build ─────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

# Active pnpm via corepack (lockfileVersion 9 → pnpm 9)
RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

# ── Copier les fichiers de configuration workspace ──
# (couche Docker cachée séparément des sources)
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json .npmrc ./
COPY tsconfig.base.json tsconfig.json ./

# ── Copier uniquement les packages nécessaires à l'API ──
COPY lib/db/         lib/db/
COPY lib/api-zod/    lib/api-zod/
COPY artifacts/api-server/ artifacts/api-server/

# ── Installer les dépendances (depuis le lockfile figé) ──
# --frozen-lockfile : interdit toute mise à jour du lockfile
# --ignore-scripts  : évite les scripts postinstall qui supposent un environnement Replit
RUN pnpm install --no-frozen-lockfile --ignore-scripts

# ── Compiler le bundle esbuild ──
RUN pnpm --filter @workspace/api-server run build


# ─── Stage 2 : Runtime minimal ───────────────────────────────────────────────
FROM node:22-alpine AS runtime

WORKDIR /app

# Le bundle esbuild est autonome (pg, drizzle, express sont inclus)
COPY --from=builder /app/artifacts/api-server/dist ./dist

ENV PORT=3000
ENV NODE_ENV=production

EXPOSE 3000

CMD ["node", "--enable-source-maps", "/app/dist/index.mjs"]
